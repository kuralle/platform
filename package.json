{
  "name": "kuralle",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "@cloudflare/workers-types": "^4.20251213.0",
      "hono": "^4.8.2",
      "@orpc/server": "^1.14.2",
      "@orpc/openapi": "^1.14.2",
      "@orpc/zod": "^1.14.2",
      "better-auth": "1.5.5",
      "alchemy": "^0.91.2",
      "next-themes": "^0.4.6",
      "@neondatabase/serverless": "^1.1.0",
      "pg": "^8.14.1",
      "drizzle-kit": "^0.31.10",
      "drizzle-orm": "^0.45.2",
      "@orpc/client": "^1.14.2",
      "@orpc/tanstack-query": "^1.14.2",
      "@tanstack/react-query": "^5.100.9",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "eslint .",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @kuralle/db db:push",
    "db:generate": "turbo -F @kuralle/db db:generate",
    "deploy": "turbo -F @kuralle/infra deploy",
    "destroy": "turbo -F @kuralle/infra destroy"
  },
  "dependencies": {
    "@kuralle/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@kuralle/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "^9.39.4",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "bun@1.3.9"
}
