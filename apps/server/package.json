{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev:wrangler": "wrangler dev --config wrangler.jsonc",
    "gen:openapi": "bun run scripts/gen-openapi.ts",
    "test": "vitest run",
    "test:slo": "vitest run --config vitest.slo.config.ts",
    "test:slo:do": "vitest run --config vitest.slo.do.config.ts",
    "test:wrangler": "vitest run src/durable-objects/MessagingDO.test.ts"
  },
  "dependencies": {
    "@kuralle-agents/cf-agent": "^0.5.0",
    "@kuralle-agents/core": "^0.5.0",
    "@kuralle-agents/messaging": "^0.5.0",
    "@kuralle-agents/messaging-meta": "^0.5.0",
    "@kuralle/api": "workspace:*",
    "@kuralle/auth": "workspace:*",
    "@kuralle/core": "workspace:*",
    "@kuralle/db": "workspace:*",
    "@kuralle/env": "workspace:*",
    "@kuralle/platform": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.3",
    "@cloudflare/workers-types": "catalog:",
    "@kuralle/config": "workspace:*",
    "@kuralle/platform": "workspace:*",
    "@kuralle/runtime": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.11.11",
    "alchemy": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "tsdown": "^0.21.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.77.0"
  }
}
