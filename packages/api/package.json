{
  "name": "@kuralle/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:rbac-matrix": "vitest run src/routers/rbac-matrix.test.ts",
    "test:pagination": "vitest run src/routers/conversations.pagination.test.ts",
    "test:api-suite": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@kuralle/auth": "workspace:*",
    "@kuralle/core": "workspace:*",
    "@kuralle/db": "workspace:*",
    "@kuralle/env": "workspace:*",
    "@kuralle/platform": "workspace:*",
    "@kuralle/runtime": "workspace:*",
    "drizzle-orm": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kuralle/config": "workspace:*",
    "@types/node": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
