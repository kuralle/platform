{
  "name": "@kuralle/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun scripts/seed-calderon.ts"
  },
  "dependencies": {
    "@kuralle/env": "workspace:*",
    "@neondatabase/serverless": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kuralle/config": "workspace:*",
    "drizzle-kit": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:"
  }
}
